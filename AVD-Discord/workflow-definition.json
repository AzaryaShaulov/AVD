{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "discordWebhookUrl": {
      "type": "SecureString",
      "metadata": {
        "description": "Discord incoming webhook URL."
      }
    },
    "discordUsername": {
      "type": "String",
      "defaultValue": "Azure Monitor"
    },
    "discordAvatarUrl": {
      "type": "String",
      "defaultValue": ""
    },
    "environmentName": {
      "type": "String",
      "defaultValue": "Production"
    }
  },
  "triggers": {
    "When_an_HTTP_request_is_received": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "schemaId": { "type": "string" },
            "data": {
              "type": "object",
              "properties": {
                "essentials": {
                  "type": "object",
                  "properties": {
                    "alertId": { "type": "string" },
                    "alertRule": { "type": "string" },
                    "severity": { "type": "string" },
                    "signalType": { "type": "string" },
                    "monitorCondition": { "type": "string" },
                    "monitoringService": { "type": "string" },
                    "alertTargetIDs": { "type": "array", "items": { "type": "string" } },
                    "configurationItems": { "type": "array", "items": { "type": "string" } },
                    "originAlertId": { "type": "string" },
                    "firedDateTime": { "type": "string" },
                    "resolvedDateTime": { "type": "string" },
                    "description": { "type": "string" },
                    "essentialsVersion": { "type": "string" },
                    "alertContextVersion": { "type": "string" }
                  }
                },
                "alertContext": { "type": "object" },
                "customProperties": { "type": "object" }
              }
            }
          }
        }
      }
    }
  },
  "actions": {
    "Initialize_Essentials": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "essentials",
            "type": "object",
            "value": "@coalesce(triggerBody()?['data']?['essentials'], json('{}'))"
          }
        ]
      }
    },
    "Initialize_AlertContext": {
      "type": "InitializeVariable",
      "runAfter": { "Initialize_Essentials": [ "Succeeded" ] },
      "inputs": {
        "variables": [
          {
            "name": "alertContext",
            "type": "object",
            "value": "@coalesce(triggerBody()?['data']?['alertContext'], json('{}'))"
          }
        ]
      }
    },
    "Initialize_CustomProperties": {
      "type": "InitializeVariable",
      "runAfter": { "Initialize_AlertContext": [ "Succeeded" ] },
      "inputs": {
        "variables": [
          {
            "name": "customProperties",
            "type": "object",
            "value": "@coalesce(triggerBody()?['data']?['customProperties'], json('{}'))"
          }
        ]
      }
    },
    "Compose_SafeFields": {
      "type": "Compose",
      "runAfter": { "Initialize_CustomProperties": [ "Succeeded" ] },
      "inputs": {
        "alertRule": "@coalesce(variables('essentials')?['alertRule'], 'Unknown Alert')",
        "severity": "@coalesce(variables('essentials')?['severity'], 'Unknown')",
        "monitorCondition": "@coalesce(variables('essentials')?['monitorCondition'], 'Unknown')",
        "signalType": "@coalesce(variables('essentials')?['signalType'], 'Unknown')",
        "monitoringService": "@coalesce(variables('essentials')?['monitoringService'], 'Unknown')",
        "firedDateTime": "@coalesce(variables('essentials')?['firedDateTime'], 'N/A')",
        "description": "@coalesce(variables('essentials')?['description'], '')",
        "targetResources": "@if(greater(length(coalesce(variables('essentials')?['alertTargetIDs'], json('[]'))), 0), join(take(coalesce(variables('essentials')?['alertTargetIDs'], json('[]')), 3), '\n'), 'N/A')",
        "targetTruncated": "@if(greater(length(coalesce(variables('essentials')?['alertTargetIDs'], json('[]'))), 3), concat('... and ', string(sub(length(coalesce(variables('essentials')?['alertTargetIDs'], json('[]'))), 3)), ' more'), '')",
        "windowStart": "@coalesce(triggerBody()?['data']?['alertContext']?['condition']?['windowStartTime'], triggerBody()?['data']?['alertContext']?['windowStartTime'], 'N/A')",
        "windowEnd": "@coalesce(triggerBody()?['data']?['alertContext']?['condition']?['windowEndTime'], triggerBody()?['data']?['alertContext']?['windowEndTime'], 'N/A')"
      }
    },
    "Compose_SeverityColor": {
      "type": "Compose",
      "runAfter": { "Compose_SafeFields": [ "Succeeded" ] },
      "inputs": "@if(equals(outputs('Compose_SafeFields')?['severity'],'Sev0'),16711680,if(equals(outputs('Compose_SafeFields')?['severity'],'Sev1'),16744448,if(equals(outputs('Compose_SafeFields')?['severity'],'Sev2'),16776960,if(equals(outputs('Compose_SafeFields')?['severity'],'Sev3'),3447003,5592405))))"
    },
    "Compose_StatusEmoji": {
      "type": "Compose",
      "runAfter": { "Compose_SafeFields": [ "Succeeded" ] },
      "inputs": "@if(equals(outputs('Compose_SafeFields')?['monitorCondition'],'Fired'),'\u26d4','\u2705')"
    },
    "Compose_AlertContextFields": {
      "type": "Compose",
      "runAfter": { "Initialize_CustomProperties": [ "Succeeded" ] },
      "inputs": "@if(or(equals(variables('alertContext'), json('{}')), equals(variables('alertContext'), null), equals(coalesce(variables('alertContext')?['condition']?['allOf'], null), null)), if(not(equals(coalesce(variables('alertContext')?['SearchResults']?['tables'], variables('alertContext')?['IncludedSearchResults']?['tables'], null), null)), createArray(setProperty(json('{\"name\":\"Search Results\",\"inline\":false}'), 'value', concat(string(length(coalesce(variables('alertContext')?['SearchResults']?['tables'], variables('alertContext')?['IncludedSearchResults']?['tables'], json('[]')))), ' table(s) returned'))), json('[]')), createArray(setProperty(json('{\"name\":\"Search Query\",\"inline\":false}'), 'value', concat('```', decodeUriComponent('%0A'), take(coalesce(variables('alertContext')?['condition']?['allOf']?[0]?['searchQuery'], variables('alertContext')?['condition']?['allOf']?[0]?['metricName'], 'N/A'), 900), decodeUriComponent('%0A'), '```')), setProperty(json('{\"name\":\"Operator\",\"inline\":true}'), 'value', coalesce(variables('alertContext')?['condition']?['allOf']?[0]?['operator'], 'N/A')), setProperty(json('{\"name\":\"Threshold\",\"inline\":true}'), 'value', coalesce(string(variables('alertContext')?['condition']?['allOf']?[0]?['threshold']), 'N/A')), setProperty(json('{\"name\":\"Metric Value\",\"inline\":true}'), 'value', coalesce(string(variables('alertContext')?['condition']?['allOf']?[0]?['metricValue']), 'N/A'))))"
    },
    "Compose_ResourceName": {
      "type": "Compose",
      "runAfter": { "Compose_SafeFields": [ "Succeeded" ] },
      "inputs": "@if(greater(length(coalesce(variables('essentials')?['alertTargetIDs'], json('[]'))), 0), last(split(first(coalesce(variables('essentials')?['alertTargetIDs'], json('[\"N/A\"]'))), '/')), 'N/A')"
    },
    "Scope_PostToDiscord": {
      "type": "Scope",
      "runAfter": {
        "Compose_SeverityColor": [ "Succeeded" ],
        "Compose_StatusEmoji": [ "Succeeded" ],
        "Compose_AlertContextFields": [ "Succeeded" ],
        "Compose_ResourceName": [ "Succeeded" ]
      },
      "actions": {
        "Build_Description": {
          "type": "Compose",
          "runAfter": {},
          "inputs": "@take(concat(outputs('Compose_SafeFields')?['severity'], ' alert from ', outputs('Compose_SafeFields')?['monitoringService'], if(equals(outputs('Compose_SafeFields')?['description'], ''), '', concat('\n\n', outputs('Compose_SafeFields')?['description']))), 2048)"
        },
        "Build_Embed_Fields": {
          "type": "Compose",
          "runAfter": { "Build_Description": [ "Succeeded" ] },
          "inputs": [
            { "name": "Severity",            "value": "@outputs('Compose_SafeFields')?['severity']",          "inline": true },
            { "name": "Condition",            "value": "@outputs('Compose_SafeFields')?['monitorCondition']",  "inline": true },
            { "name": "Signal Type",          "value": "@outputs('Compose_SafeFields')?['signalType']",        "inline": true },
            { "name": "Monitoring Service",   "value": "@outputs('Compose_SafeFields')?['monitoringService']", "inline": true },
            { "name": "Fired Time (UTC)",     "value": "@outputs('Compose_SafeFields')?['firedDateTime']",     "inline": true },
            { "name": "Environment",          "value": "@parameters('environmentName')",                        "inline": true },
            { "name": "Window Start",         "value": "@outputs('Compose_SafeFields')?['windowStart']",       "inline": true },
            { "name": "Window End",           "value": "@outputs('Compose_SafeFields')?['windowEnd']",         "inline": true },
            { "name": "\u200b",               "value": "\u200b",                                                "inline": true }
          ]
        },
        "Append_Target_Field": {
          "type": "Compose",
          "runAfter": { "Build_Embed_Fields": [ "Succeeded" ] },
          "inputs": "@union(outputs('Build_Embed_Fields'), createArray(json(concat('{\"name\":\"Target Resource\",\"value\":\"', outputs('Compose_ResourceName'), '\\n`', replace(take(first(coalesce(variables('essentials')?['alertTargetIDs'], json('[\"N/A\"]'))), 200), '\"', ''), '`\",\"inline\":false}'))))"
        },
        "Append_AlertContext_Fields": {
          "type": "Compose",
          "runAfter": { "Append_Target_Field": [ "Succeeded" ] },
          "inputs": "@if(equals(length(outputs('Compose_AlertContextFields')), 0), outputs('Append_Target_Field'), union(outputs('Append_Target_Field'), outputs('Compose_AlertContextFields')))"
        },
        "Post_To_Discord": {
          "type": "Http",
          "runAfter": { "Append_AlertContext_Fields": [ "Succeeded" ] },
          "inputs": {
            "method": "POST",
            "uri": "@parameters('discordWebhookUrl')",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "username": "@parameters('discordUsername')",
              "avatar_url": "@if(equals(parameters('discordAvatarUrl'),''),null,parameters('discordAvatarUrl'))",
              "embeds": [
                {
                  "title": "@concat(outputs('Compose_StatusEmoji'), ' ', take(outputs('Compose_SafeFields')?['alertRule'], 200), ' - ', outputs('Compose_SafeFields')?['monitorCondition'])",
                  "description": "@outputs('Build_Description')",
                  "color": "@outputs('Compose_SeverityColor')",
                  "fields": "@outputs('Append_AlertContext_Fields')",
                  "timestamp": "@outputs('Compose_SafeFields')?['firedDateTime']",
                  "footer": {
                    "text": "@concat(parameters('environmentName'), ' \u2022 Azure Monitor')"
                  }
                }
              ]
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT5S",
              "minimumInterval": "PT5S",
              "maximumInterval": "PT30S"
            }
          }
        }
      }
    },
    "Response_Success": {
      "type": "Response",
      "runAfter": { "Scope_PostToDiscord": [ "Succeeded" ] },
      "inputs": {
        "statusCode": 200,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "status": "ok",
          "alertRule": "@outputs('Compose_SafeFields')?['alertRule']",
          "discordStatus": "@outputs('Post_To_Discord')?['statusCode']"
        }
      }
    },
    "Response_Failure": {
      "type": "Response",
      "runAfter": { "Scope_PostToDiscord": [ "Failed", "TimedOut" ] },
      "inputs": {
        "statusCode": 502,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "status": "error",
          "message": "Failed to post alert to Discord.",
          "alertRule": "@coalesce(outputs('Compose_SafeFields')?['alertRule'], 'Unknown')",
          "discordResponseCode": "@coalesce(outputs('Post_To_Discord')?['statusCode'], 'N/A')"
        }
      }
    }
  },
  "outputs": {}
}
